    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code is available!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building PetClinic application!'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests!'
            }
        }
    }
}
